# Firebase config for the emulator e2e build ONLY (loaded via `vite --mode
# emulator`, envDir points here so a real .env.local can't override it).
#
# These are throwaway placeholders — the SDK connects to the local Auth +
# Firestore emulators (see VITE_FIREBASE_EMULATOR), never a real project. The
# project id must match the id the emulators + seed script run under (demo-rdr2;
# the `demo-` prefix keeps the emulator suite fully offline).
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=demo-rdr2.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=demo-rdr2
VITE_FIREBASE_APP_ID=demo-app-id
VITE_FIREBASE_EMULATOR=1
