{
  "name": "rdr2-inventory-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "RDR2 crafting inventory tracker with per-cell delivered/required, freezable rows & columns, Firebase or offline storage.",
  "scripts": {
    "dev": "vite",
    "build": "svelte-check --tsconfig ./tsconfig.json && vite build",
    "build:ci": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "eslint . && prettier --check .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/svelte": "^5.2.6",
    "@testing-library/user-event": "^14.5.2",
    "@tsconfig/svelte": "^5.0.4",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.9.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.4",
    "svelte-eslint-parser": "^1.8.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.0.11",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.0.5"
  },
  "dependencies": {
    "@e965/xlsx": "^0.20.3",
    "firebase": "^11.2.0"
  }
}
