# Firebase web app configuration.
#
# These values identify your Firebase project and are shipped to the browser —
# they are NOT secrets. Access is protected by Firebase Auth + Firestore
# security rules (see firestore.rules), not by keeping these hidden.
#
# Copy to `.env.local` and fill in from:
#   Firebase console → Project settings → General → Your apps → SDK setup & config.
#
# Leaving these blank runs the app in offline-only mode (localStorage), with the
# Firebase sign-in form hidden.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: Google Analytics (GA4) measurement id, e.g. G-XXXXXXXXXX.
# Found next to the other values in the Firebase console SDK config once GA is
# enabled for the web app. Leave blank to ship without analytics. Even when set,
# nothing is collected until the user opts in (Google Consent Mode v2).
VITE_FIREBASE_MEASUREMENT_ID=

# --- Billing (Stripe, via the "Run Payments with Stripe" Firebase extension) ---
# Stripe Price id for the Pro subscription that unlocks cloud sync (e.g.
# price_123...). Leave blank to run without a purchasable Pro plan.
VITE_STRIPE_PRICE_ID=

# Dev-only: set to 1 to force the Pro path in a `npm run dev` build when the
# Stripe extension isn't available (e.g. on the Firebase Spark plan). Ignored in
# production builds. Never set this in deployment.
VITE_DEV_FORCE_PRO=
