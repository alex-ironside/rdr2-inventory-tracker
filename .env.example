# Firebase web app configuration.
#
# These values identify your Firebase project and are shipped to the browser —
# they are NOT secrets. Access is protected by Firebase Auth + Firestore
# security rules (see firestore.rules), not by keeping these hidden.
#
# Copy to `.env.local` and fill in from:
#   Firebase console → Project settings → General → Your apps → SDK setup & config.
#
# Leaving these blank runs the app in offline-only mode (localStorage), with the
# Firebase sign-in form hidden.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
